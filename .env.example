# Database (PostgreSQL 16)
DATABASE_URL="postgresql://patii:patii_secret@localhost:5432/patii?schema=public"

# Redis (Redis 7)
REDIS_URL="redis://localhost:6379"

# Server Configuration
PORT=4000
NODE_ENV="development"
JWT_SECRET="patii-dev-jwt-secret-key-at-least-32-chars-long"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="30d"

# Google OAuth (Auth & FCM)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
FIREBASE_PROJECT_ID="patii-dev"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@patii-dev.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY=""

# Admin App Configuration
NEXT_PUBLIC_API_URL="http://localhost:4000"
ADMIN_JWT_SECRET="patii-admin-dev-secret-key-at-least-32-chars"
ADMIN_TOTP_ISSUER="Patii Admin"
